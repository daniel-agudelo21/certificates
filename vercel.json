{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "npm run build --workspace=frontend",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/generate.ts": {
      "maxDuration": 30,
      "includeFiles": "api/{fonts,assets}/**"
    }
  }
}
